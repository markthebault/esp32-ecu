* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.zip binary
*.FCStd binary
*.blend binary
*.stl binary
# Preserve exporter formatting in generated CAD and validation artifacts.
*.step -whitespace
reports/**/*.svg -whitespace
reports/**/*.txt -whitespace
reports/*.svg -whitespace
reports/*.txt -whitespace
# MSL unit rows retain empty trailing fields in their tab-separated layout.
*.msl whitespace=-blank-at-eol

# Preserve application-authored tuning files and raw sequential build logs.
tuning/examples/tunerstudio-sequential-roundtrip.msq -whitespace
reports/engine/sequential/*.log -whitespace
