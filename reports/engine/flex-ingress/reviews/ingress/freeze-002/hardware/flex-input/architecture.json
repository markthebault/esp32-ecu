{
  "contract": "FLEX-G38-DRAFT1",
  "status": "architecture_only_not_for_fabrication_or_sensor_connection",
  "parent_carrier": "a5-idle-interface",
  "board_limit_mm": [120, 120],
  "module": "pluggable_44_pin_ESP32-S3_N16R8",
  "construction": "leaded_home_solderable_direct_solder_DIP_no_DIP_sockets",
  "implementation": {
    "portable_integer_ingress": true,
    "target_producer": false,
    "shared_bus_led_driver": false,
    "protected_input_circuit": false,
    "native_cad": false,
    "physical_qualification": false,
    "engine_outputs_enabled": false
  },
  "allocation": {
    "flex_signal": {"gpio": 38, "module_pad": 32, "direction": "input_only_after_output_disable"},
    "boot_pair": {"gpio": 0, "unchanged": true},
    "idle": {"gpio": 3, "unchanged": true},
    "reserved_straps": [45, 46],
    "status_led": {
      "interface": "MCP23008_PDIP18_at_0x21",
      "i2c_sda_gpio": 41,
      "i2c_scl_gpio": 42,
      "rgb_outputs": [0, 1, 2],
      "gp7": "NC_but_IODIR_bit7_must_be_zero",
      "ordinary_rgb_led_driver_and_resistors": "not_selected",
      "old_GPIO38_WS2812_wiring_compatible": false,
      "old_GPIO38_RMT_initialization_and_writes_allowed": false,
      "noncompact_GPIO38_ARM_build_allowed": false,
      "steady_green_is_proof_of_live_CPU_or_light_output": false
    }
  },
  "capture": {
    "group": 0,
    "timer": "existing_common_crank_cam_APB_timer",
    "channel": 2,
    "interrupt_priority": 3,
    "prescale": 1,
    "edges": "both",
    "low_pulse_meaning": "physical_sensor_LOW_preserved_after_conditioning",
    "resync_or_stop_shared_timer_on_flex_change": false,
    "clear_or_mask_crank_cam_interrupt_status": false,
    "hardware_edge_FIFO": false,
    "lossless_capture_claim": false,
    "single_worker_owns_floating_point_capture": true,
    "stop_rearm_binding_change_invalidates_separate_capture_series": true,
    "sample_now_under_external_lock": true,
    "snapshot_holdoff_time_basis": "last_observed_us_not_live_read_time",
    "ISR_queue_capacity": 64,
    "minimum_edge_interval_us": 50,
    "maximum_reported_latch_age_us": 5000,
    "fixed_callback_window_us": 10000,
    "callbacks_per_window": 32,
    "retry_holdoff_us": 50000,
    "masked_holdoff_proves_electrical_quiet": false,
    "context": "strictly_increasing_nonzero_U64_owner_binding_identifier",
    "fault_ack": "exact_offered_context_generation_after_completed_matching_control",
    "acquire_when": "corrections_enabled_OR_secondary_ethanol_required"
  },
  "shared_i2c": {
    "owner_count": 1,
    "switch_address": 32,
    "led_address": 33,
    "clock_hz": 100000,
    "tick_us": 5000,
    "total_budget_us": 3000,
    "priority": "required_switch_guard_then_LED_only_with_remaining_budget",
    "second_full_LED_budget_allowed": false,
    "release_bus_when": "neither_device_owns_it",
    "switch_IODIR_expected": 127,
    "switch_GP7_GP6_challenge_preserved": true,
    "mask_IODIR_bit7_to_accept_reset_value": false,
    "led_initialize": "OLAT_off_before_direction_then_verify_full_legal_IODIR_and_latch",
    "led_diagnostics": ["desired", "last_verified_latch", "verified_age", "bus_failure_or_unknown"],
    "failed_bus_guarantees_red_or_off": false
  },
  "unresolved_electrical_gates": [
    "select_sensor_model_supply_and_harness_pinout",
    "input_voltage_current_clamps_and_fault_energy",
    "sensor_power_present_with_carrier_off_back_power",
    "conditioner_polarity_bias_and_worst_case_pulse_skew",
    "possible_reuse_of_two_spare_3V3_SN74HC14N_gates_is_not_a_qualified_frontend",
    "LED_driver_headroom_current_reset_default_and_sealed_window",
    "boot_reset_partial_power_BootPair_download_and_input_noise_tests",
    "all_target_timing_interference_heap_stack_and_HIL_measurements",
    "routing_case_fit_EMI_surge_thermal_splash_and_vehicle_qualification"
  ],
  "references": [
    {"title": "ESP32-S3 datasheet v2.2", "url": "https://www.espressif.com/sites/default/files/documentation/esp32-s3_datasheet_en.pdf", "locators": "boot strapping pp32-34"},
    {"title": "ESP32-S3 technical reference manual", "url": "https://www.espressif.com/sites/default/files/documentation/esp32-s3_technical_reference_manual_en.pdf", "locators": "reset domains, GPIO strap latches, MCPWM capture latches"},
    {"title": "Pinned ESP-IDF5.5 MCPWM documentation", "url": "https://docs.espressif.com/projects/esp-idf/en/v5.5/esp32s3/api-reference/peripherals/mcpwm.html", "locators": "shared group interrupt source and capture configuration"},
    {"title": "Microchip MCP23008 DS20001919I", "url": "https://ww1.microchip.com/downloads/aemDocuments/documents/APID/ProductDocuments/DataSheets/MCP23008-and-MCP23008-Data-Sheet-DS20001919.pdf", "locators": "GP7 output only, Register1-1 IO7=0, full-byte register semantics"}
  ]
}
