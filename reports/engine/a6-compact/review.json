  "open_findings": [
    {
      "id": "INC-PARASITICS-01",
      "priority": "physical_qualification_hold",
      "finding": "No physical 5pF/15pF/10pF comparator-input/output/GPIO bound has been established. The previous same-layer IN/CMP parallel witness is absent. Actual current FLEX_IN on In2 and ADC7 on adjacent In3 have 2.25mm parallel overlap with 0.025mm projected center spacing; no ground layer lies between these two signal layers. This is a geometric coupling witness, not a demonstrated excess capacitance or functional defect.",
      "action": "Keep the capacitance assumptions conditional. Use a specified dielectric/copper stack and extraction or physical measurements, including ADC activity, before claiming a post-layout parasitic bound. No mandatory routing change follows from this review alone.",
      "evidence": [
        "independent-native-inspection.json:nearby_parallel_pairs",
        "native-locality-six-layers.png"
      ]
    },
    {
      "id": "INC-SUPPLY-01",
      "priority": "physical_qualification_hold",
      "finding": "C160 and C164 improve native locality, but every executed deck models nominal ideal 100nF capacitors on assumed sources. X7R effective capacitance, DC bias, ESR/ESL and actual rail impedance/transients are outside these results. Ground sampling shows connected, broadly continuous In1/In4 pours and normal PTH clearances; it does not prove a continuous screen under every segment or a return-impedance bound.",
      "action": "Retain the supply-stability hold and validate the selected assembled capacitors and rails physically or with justified nonideal supply models. Do not describe the ideal-cap matrix as a supply-transient or full-temperature stability guarantee.",
      "evidence": [
        "independent-model-inspection.json",
        "independent-native-inspection.json:GND_return_samples",
        "independent-native-inspection.json:plane_under_route_samples",
        "native-locality-six-layers.png"
      ]
    },
    {
      "id": "INC-CURRENT-01",
      "priority": "current_thermal_qualification_hold",
      "finding": "The three literal prior INJ1 0.8mm objects remain the sole audited power-width exceptions. The native floor deliberately permits 0.8mm on INJ1 generally; native zero-DRC alone would also accept an extra 0.8mm segment or a 10um change to an authorized neck. Both the independent exact policy and the actual frozen audit reject those mutations. Width and nominal P70 arithmetic are not current, derating, pulse, I2t or assembled-temperature ratings.",
      "action": "Retain the exact UUID/net/layer/endpoints audit as a required companion to native DRC. Close the current/thermal/fuse hold with load-specific evidence before fabrication or operation.",
      "evidence": [
        "independent-native-negative-controls.json",
        "declared-audit-controls.json",
        "independent-native-inspection.json",
        "independent-model-inspection.json:resistor_peak_w"
      ]
    },
    {
      "id": "INC-ASSEMBLY-01",
      "priority": "physical_fit_qualification_hold",
      "finding": "Native compact package identities, holes/pitches, fixed-part preservation and J20 courtyard containment are coherent. They do not qualify formed MRS16 leads, C315 pitch tolerance and finished 0.8mm holes, hand-solder thermal behavior, PH crimp/strap performance, N16R8 stack/antenna, printed parts or case fit. J20 remains an internal two-pin CHASSIS bond with no normal load return; H5 remains CHASSIS.",
      "action": "Retain actual-part lead-form/finished-hole/thermal and assembled module/case/RF checks. Preserve the separate unresolved external J22 sensor pin mapping and unqualified FLEX_12V behavior.",
      "evidence": [
        "independent-native-inspection.json",
        "footprint-provenance-checks.json",
        "publication-comparison.json"
      ]
    }
  ],
